# Banco de Dados
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/jk-store

# Email (Gmail ou outro SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-app

# WhatsApp (usar Twilio ou similar)
WHATSAPP_API_KEY=sua-chave-api
TWILIO_ACCOUNT_SID=seu-sid
TWILIO_AUTH_TOKEN=seu-token
TWILIO_WHATSAPP_NUMBER=+5511999999999

# Dados da Empresa
COMPANY_WHATSAPP=(19)97108-0410
COMPANY_EMAIL=contato@jkstore.com.br
COMPANY_NAME=JK Store

# Servidor
PORT=5000
NODE_ENV=development
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# JWT (opcional, para autenticação)
JWT_SECRET=sua-chave-secreta-aqui

# Vercel (para variáveis de ambiente da produção)
VERCEL_URL=sua-url-vercel.vercel.app

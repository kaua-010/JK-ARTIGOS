{
  "version": 2,
  "builds": [
    {
      "src": "server/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "public/$1"
    }
  ],
  "env": {
    "MONGODB_URI": "@mongodb_uri",
    "SMTP_USER": "@smtp_user",
    "SMTP_PASS": "@smtp_pass",
    "TWILIO_ACCOUNT_SID": "@twilio_account_sid",
    "TWILIO_AUTH_TOKEN": "@twilio_auth_token",
    "COMPANY_WHATSAPP": "@company_whatsapp",
    "COMPANY_EMAIL": "@company_email"
  }
}
